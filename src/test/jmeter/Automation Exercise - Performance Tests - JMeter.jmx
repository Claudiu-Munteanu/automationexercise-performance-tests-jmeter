        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST To Verify Login with valid details" enabled="true">
            <stringProp name="HTTPSampler.path">/api/verifyLogin</stringProp>
